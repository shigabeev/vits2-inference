[Unit]
Description=TTS inference web interface for VITS 2
After=network.target

[Service]
User=frappuccino
WorkingDirectory=/home/frappuccino/vits2-shergin
ExecStart=/home/frappuccino/.local/bin/streamlit run /home/frappuccino/vits2-shergin/streamlit_fastapi.py --server.port 8080
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
